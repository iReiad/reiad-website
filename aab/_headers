# ============================================================
# _headers: Cloudflare Pages reads this file and sends these
# headers with the matching responses. Local preview ignores it,
# so anything here has to be verified on a deploy.
# ============================================================

/*
  # Don't let the site be framed by anyone else.
  X-Frame-Options: DENY
  # Don't let a browser guess a file is something it isn't.
  X-Content-Type-Options: nosniff
  # Send the origin to other sites, the full URL to our own.
  Referrer-Policy: strict-origin-when-cross-origin
  # Turn off the powerful APIs this site has no use for. WebAuthn is
  # listed explicitly as (self) rather than left to the default, so a
  # future tightening of this line can't silently break the Studio's
  # passkey unlock.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=(), publickey-credentials-get=(self), publickey-credentials-create=(self)
  # HTTPS only, including subdomains, for a year.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Content Security Policy. Everything comes from here except the
  # fonts. 'unsafe-inline' covers the pre-paint theme script, the
  # speculation rules, the JSON-LD blocks and the handful of inline
  # style attributes. img-src needs data: for the photos the Studio
  # embeds.
  #
  # connect-src is the list of hosts this site's JavaScript may talk
  # to, and it is the one line here that breaks a feature silently.
  # Reader sign-in shipped without Supabase on it, so the browser
  # refused every request to the auth API before it left: "Failed to
  # fetch", which reads as the server being down. Google sign-in
  # still worked, because a redirect is a navigation rather than a
  # fetch, which made it look stranger still. check-csp.mjs now
  # fails if the code names a host this line does not allow.
  #
  # The Supabase host must match SUPABASE_URL in aab/account.js.
  # If that project is ever recreated, this line changes with it.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com https://market-pulse.i-reiad.workers.dev https://wvjarqnnmkkuxyrndtya.supabase.co; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Fingerprint-free assets change in place, so they must revalidate.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# The service worker must never be cached, or updates never land.
/sw.js
  Cache-Control: no-cache

# Images and icons are effectively immutable.
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Feeds should be fresh-ish.
/feed.xml
  Cache-Control: public, max-age=1800
  Content-Type: application/rss+xml; charset=utf-8

# The publishing tool is not for search engines.
/studio.html
  X-Robots-Tag: noindex, nofollow

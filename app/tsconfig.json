{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* The site's own modules, which this app imports at the paths
       the browser fetches them from and Vite leaves external. Most
       are plain JavaScript and are described by a declaration in
       src/types, and src/types/README.md says why that is a better
       answer than a @ts-expect-error above each import.

       /content.js is the exception and the direction the rest are
       going: its source is shared/content.ts, so this maps the
       served path on to the module itself rather than on to a
       description of it. allowJs below is for the rest of them,
       which are still plain JavaScript. */
    "allowJs": true,
    "paths": {
      "/auth.js": ["./src/types/auth.d.ts"],
      "/app.js": ["./src/types/app.d.ts"],
      "/api.js": ["./src/types/api.d.ts"],
      "/content.js": ["../shared/content.ts"],
      "/share-card.js": ["./src/types/share-card.d.ts"],
      "/photo.js": ["./src/types/photo.d.ts"],
      "/editor.js": ["./src/types/editor.d.ts"]
    }
  },
  "include": ["src"]
}

# Local wrangler state: the dev D1 database, caches and build temp files.
# Never commit this: it's per-machine and can hold real content you
# published while testing.
.wrangler/
node_modules/
.dev.vars

# TypeScript's incremental build cache. Per-machine, rewritten on
# every build, and says nothing about the source. The React app's
# real output is aab/studio/, which IS committed and on purpose.
app/tsconfig.tsbuildinfo

# The Next.js workspace's build output and its copy of shared/.
# `.open-next/` is a Worker bundle that only the deploy needs, and
# unlike aab/studio/ it is not something the site serves as a file.
# Three paths, not one: `npx next build` writes to whichever
# directory it is run from.
next/.next/
/.next/
app/.next/
next/.open-next/
next/next-env.d.ts
next/tsconfig.tsbuildinfo
# The browser tests' own config, which check-types.ts runs.
next/tsconfig.test.tsbuildinfo

# The design harness, written by scripts/preview.ts and looked at, not kept.
aab/preview.html

# scripts/tsconfig.shared.json's scratch outDir, which only a hand
# run reaches: scripts/build-modules.ts overrides it with a temp dir.
.content-build/

# Compiled output beside a shared/ source, which must never exist.
#
# `shared/` is TypeScript that three runtimes read directly: Next
# through transpilePackages, the Worker through wrangler's esbuild,
# and plain node through type stripping. Nothing there needs a
# compile step, and `shared/README.md` says so at length.
#
# It WAS the other way round once: four sources with a committed
# `.js` and `.d.ts` beside each, which is twelve files where there
# are four, plus a build script and a check to catch somebody
# editing the output instead of the input. All of it served a
# compile step no runtime needed.
#
# A stray `tsc` run with no `--noEmit` puts them back, in place,
# untracked, where the next `git add -A` commits them. This is what
# stops that, and `scripts/check-types.ts` fails if one is tracked
# anyway.
shared/*.js
shared/*.d.ts
shared/curricula/*.js
shared/curricula/*.d.ts

# The SQL the two seeders write, which is the rows and not the
# source of them: `schools.sql` from import-schools.ts and
# `money.sql` from seed-money.ts, two megabytes of it. Both are
# built in a workflow run and handed straight to wrangler, and a
# `git add -A` after running one by hand would otherwise commit a
# second copy of every lesson.
/schools.sql
/money.sql

# Scratch bundles a harness writes into next/ so that node can
# resolve `react-dom` from there: a data: URL cannot resolve a
# bare specifier and os.tmpdir() has no node_modules. They are
# deleted by the harness that made them; this is for the run that
# was interrupted, and check-mjs.ts is what noticed.
next/.*.mjs

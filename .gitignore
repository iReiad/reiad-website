# Local wrangler state: the dev D1 database, caches and build temp files.
# Never commit this — it's per-machine and can hold real content you
# published while testing.
.wrangler/
node_modules/
.dev.vars

# Local-only. A wrangler.toml in the repo root makes Cloudflare Pages
# switch to a `wrangler deploy` build command, which fails on a Pages
# project. Copy wrangler.example.toml to wrangler.toml for local dev.
wrangler.toml

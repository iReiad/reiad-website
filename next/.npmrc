# `@reiad/shared` is a file: dependency on ../shared, the handful of
# things this route, the Worker and the browser all have to say the
# same way.
#
# npm's default for a file: dependency is a symlink, and Turbopack
# resolves a symlink to its real path and then refuses it for being
# above the project root. install-links copies the package into
# node_modules instead, which is a real directory inside the root,
# so there is no second copy of those tables in the repository.
#
# The copy lands in node_modules, and `shared/` is TypeScript with
# no compiled JavaScript beside it, so Next has to be told to
# compile it: `transpilePackages` in next.config.ts, which says the
# same thing at more length.
install-links=true

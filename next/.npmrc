# `@reiad/look` is a file: dependency on ../shared/look, the table
# both this route and the Worker's own renderer read.
#
# npm's default for a file: dependency is a symlink, and Turbopack
# resolves a symlink to its real path and then refuses it for being
# above the project root. install-links copies the package into
# node_modules instead, which is a real directory inside the root,
# so there is nothing to configure in next.config.ts and no second
# copy of the table in the repository.
install-links=true

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "/account.js": [
        "../app/src/types/account.d.ts"
      ],
      "/sync.js": [
        "../app/src/types/sync.d.ts"
      ],
      "/saved.js": [
        "../app/src/types/saved.d.ts"
      ],
      "/prefs.js": [
        "../app/src/types/prefs.d.ts"
      ],
      "/checkpoints.js": [
        "../app/src/types/checkpoints.d.ts"
      ],
      "/streak.js": [
        "../app/src/types/streak.d.ts"
      ],
      "/content.js": [
        "../app/src/types/content.d.ts"
      ],
      "/api.js": [
        "../app/src/types/api.d.ts"
      ]
    },
    "isolatedModules": true,
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    /* For the node-side files beside this config: `article.test.ts`
       imports `./dev-worker.ts` by its real filename, because node
       resolves the file on disk and has no opinion about what
       TypeScript would have preferred. `noEmit` below is what makes
       this legal. */
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      /* Where playwright really is: a devDependency of `app/`, and
         the browser tests beside this config import it from there
         at run time because node resolves a real path. This is so
         that they can also have its types. */
      "playwright": [
        "../app/node_modules/playwright"
      ],
      /* And the same package by the path node resolves it at. A
         `paths` entry is matched against the specifier as
         written, so the type-only name above does not cover the
         runtime one. */
      "../app/node_modules/playwright/index.mjs": [
        "../app/node_modules/playwright"
      ],
      "/account.js": [
        "../app/src/types/account.d.ts"
      ],
      "/sync.js": [
        "../app/src/types/sync.d.ts"
      ],
      "/saved.js": [
        "../app/src/types/saved.d.ts"
      ],
      "/prefs.js": [
        "../app/src/types/prefs.d.ts"
      ],
      "/checkpoints.js": [
        "../app/src/types/checkpoints.d.ts"
      ],
      "/streak.js": [
        "../app/src/types/streak.d.ts"
      ],
      "/content.js": [
        "../app/src/types/content.d.ts"
      ],
      "/api.js": [
        "../app/src/types/api.d.ts"
      ]
    },
    "isolatedModules": true,
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
